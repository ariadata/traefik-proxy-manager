{
  "name": "traefik-proxy-manager",
  "private": true,
  "version": "1.0.0",
  "description": "Single-user Traefik control plane: SQLite → YAML → Traefik file provider",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build:web && npm run build:server",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "npm run build --prefix web",
    "start": "node server/dist/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit",
    "init": "bash ./scripts/init.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.10",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "playwright": "^1.65.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

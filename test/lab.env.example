# Copy to lab.env (gitignored) and fill for your environment.
# cp test/lab.env.example test/lab.env

TPM_PANEL_URL=http://127.0.0.1:18080
TPM_ADMIN_USER=admin
TPM_ADMIN_PASS=

TPM_ORIGIN_V4=
TPM_ORIGIN_V6=
TPM_SSH_HOST=
TPM_SSH_PORT=22
TPM_SSH_USER=debian
TPM_REMOTE_DIR=~/traefik-proxy-manager

# Optional; defaults to parent of TPM_HOST_DNS01
# TPM_LAB_DOMAIN=example.com

TPM_HOST_DNS01=
TPM_HOST_HTTP01=
TPM_HOST_ACL=
TPM_HOST_REDIR=
TPM_HOST_PARK=
TPM_HOST_WS=
TPM_HOST_WAF=
TPM_HOST_RL=

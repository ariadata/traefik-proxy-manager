COMPOSE_PROJECT_NAME=tpm
UID=1000
GID=1000
DC_TZ=UTC

TRAEFIK_VERSION=v3.7

DC_TRAEFIK_HTTP_PORT=80          # container: 80
DC_TRAEFIK_HTTPS_PORT=443        # container: 443
# Admin bind — keep loopback unless you intend public port access
DC_TPM_HTTP_PORT=127.0.0.1:8080  # container: 8080
# Host publish range for TCP/UDP streams (match entry_port in Streams UI)
DC_TRAEFIK_STREAM_TCP=10000-10020:10000-10020
DC_TRAEFIK_STREAM_UDP=10000-10020:10000-10020/udp

# Encrypt DNS credentials stored by the panel (required for DNS resolvers)
# openssl rand -hex 32
TPM_SECRETS_KEY=

# How Traefik reaches TPM for dead-host pages (Compose: http://tpm:8080)
TPM_INTERNAL_URL=http://tpm:8080

# Traefik access log (Compose: /app/logs/traefik/access.log)
TPM_ACCESS_LOG=./logs/traefik/access.log

# Backup archive directory (SQLite + custom-certs + acme.json)
# TPM_BACKUP_DIR=./data/tpm/backups

# DNS/ACME provider tokens are NOT set here — add them in the TPM SSL panel.
# Control plane writes data/tpm/traefik-providers.env for Traefik.
